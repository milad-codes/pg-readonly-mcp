{
  "name": "pg-readonly-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "libpg-query": "^18.2.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "description": "MCP server that gives AI assistants read-only access to PostgreSQL: parser-checked SELECTs, read-only transactions, timeouts, row caps and query plans",
  "bin": {
    "pg-readonly-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "demo": "npm run build && node scripts/demo.mjs"
  }
}
